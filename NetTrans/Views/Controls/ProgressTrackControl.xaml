<UserControl
    x:Class="NetTrans.Views.Controls.ProgressTrackControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="6">

    <Grid x:Name="RootGrid" CornerRadius="999" Background="{ThemeResource BgSubtleBrush}">
        <Grid x:Name="FillHost" ColumnDefinitions="1*,99*">
            <Border x:Name="Fill" Grid.Column="0" CornerRadius="999"/>
        </Grid>
        <Grid x:Name="SegmentHost"/>
    </Grid>
</UserControl>
