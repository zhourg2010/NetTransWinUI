<UserControl
    x:Class="NetTrans.Views.Controls.FileBadgeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Width="36" Height="36">
        <Border x:Name="Chip" CornerRadius="8" BorderThickness="1"/>
        <Path x:Name="Glyph" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent" Width="22" Height="22"/>
        <Border x:Name="TagBorder"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-4,-4"
                CornerRadius="3"
                Padding="4,1"
                BorderThickness="1.5"
                BorderBrush="{ThemeResource BgLayerBrush}">
            <TextBlock x:Name="TagText" FontSize="8.5" FontWeight="Bold" Foreground="White" CharacterSpacing="40"/>
        </Border>
    </Grid>
</UserControl>
