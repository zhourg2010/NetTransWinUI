<UserControl
    x:Class="NetTrans.Views.Controls.MenuBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Classic File/Edit/View/Downloads/Tools/Help bar. The stock WinUI
        MenuBar control's flyout chrome doesn't match the reference (padding,
        acrylic, kbd-shortcut alignment), so this is hand-built from Buttons
        + MenuFlyout, which lets us fully control the flyout style below.
    -->
    <UserControl.Resources>
        <Style x:Key="TopMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                               Padding="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BgHoverBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BgSelectedBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <MenuFlyout x:Key="FileFlyout" Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Text="New download…" Click="OnNewDownloadClick">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Import URL list…"/>
            <MenuFlyoutItem Text="Open downloads folder"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Export history…"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Exit" Click="OnExitClick"/>
        </MenuFlyout>

        <MenuFlyout x:Key="EditFlyout" Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Text="Cut"/>
            <MenuFlyoutItem Text="Copy URL"/>
            <MenuFlyoutItem Text="Paste URL"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Select all"/>
            <MenuFlyoutItem Text="Find…"/>
        </MenuFlyout>

        <MenuFlyout x:Key="ViewFlyout" Placement="BottomEdgeAlignedLeft">
            <ToggleMenuFlyoutItem Text="Show detail panel" IsChecked="True"/>
            <ToggleMenuFlyoutItem Text="Show categories" IsChecked="True"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Group by status"/>
            <ToggleMenuFlyoutItem Text="Group by category" IsChecked="True"/>
            <MenuFlyoutItem Text="Group by date"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Compact density"/>
        </MenuFlyout>

        <MenuFlyout x:Key="DownloadsFlyout" Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Text="Pause all" Click="OnPauseAllClick"/>
            <MenuFlyoutItem Text="Resume all" Click="OnResumeAllClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Remove completed"/>
            <MenuFlyoutItem Text="Verify checksums"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Schedule for off-peak…"/>
        </MenuFlyout>

        <MenuFlyout x:Key="ToolsFlyout" Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Text="Browser integration…"/>
            <MenuFlyoutItem Text="Speed limiter…"/>
            <MenuFlyoutItem Text="Site logins…"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Settings…" Click="OnSettingsClick"/>
        </MenuFlyout>

        <MenuFlyout x:Key="HelpFlyout" Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Text="Documentation"/>
            <MenuFlyoutItem Text="Keyboard shortcuts"/>
            <MenuFlyoutItem Text="Report a problem…"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="About NetTrans"/>
        </MenuFlyout>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="0" Height="28" Padding="6,0" VerticalAlignment="Center">
        <Button Style="{StaticResource TopMenuButtonStyle}" Content="File" Flyout="{StaticResource FileFlyout}"/>
        <Button Style="{StaticResource TopMenuButtonStyle}" Content="Edit" Flyout="{StaticResource EditFlyout}"/>
        <Button Style="{StaticResource TopMenuButtonStyle}" Content="View" Flyout="{StaticResource ViewFlyout}"/>
        <Button Style="{StaticResource TopMenuButtonStyle}" Content="Downloads" Flyout="{StaticResource DownloadsFlyout}"/>
        <Button Style="{StaticResource TopMenuButtonStyle}" Content="Tools" Flyout="{StaticResource ToolsFlyout}"/>
        <Button Style="{StaticResource TopMenuButtonStyle}" Content="Help" Flyout="{StaticResource HelpFlyout}"/>
    </StackPanel>
</UserControl>
