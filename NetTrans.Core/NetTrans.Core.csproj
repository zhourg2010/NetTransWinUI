<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every part of NetTrans that has no dependency on WinUI or on Windows:
    the task model, the design's formatting rules, list querying, the docking
    geometry and the progress simulation.

    It targets plain net8.0 on purpose. The shell can only be built and run on
    Windows, but this half can be built and unit-tested anywhere, which is what
    NetTrans.Core.Tests does.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NetTrans</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The test project checks a few helpers that are internal because nothing
      outside this assembly should call them - the block map a transfer folds
      its progress onto, the attribute splitter the playlist reader uses. They
      are worth testing directly rather than only through the transfer that
      owns them.
    -->
    <InternalsVisibleTo Include="NetTrans.Core.Tests"/>
  </ItemGroup>

</Project>
