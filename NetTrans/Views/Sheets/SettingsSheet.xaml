<UserControl
    x:Class="NetTrans.Views.Sheets.SettingsSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls">

    <controls:SheetHost
        x:Name="Host"
        Title="设置"
        LeftLabel=""
        RightLabel="完成"
        Cancelled="OnClosed"
        Confirmed="OnClosed">

        <StackPanel>
            <TextBlock Margin="4,0,4,6" Style="{StaticResource GroupHeaderTextStyle}" Text="下载"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <controls:FormRow x:Name="SavePathRow" Label="默认位置" ShowChevron="True" ShowSeparator="False"/>

                    <controls:FormRow Label="按分类分文件夹">
                        <controls:IosSwitch x:Name="FoldersSwitch" Toggled="OnFoldersToggled"/>
                    </controls:FormRow>

                    <controls:FormRow Label="同时下载">
                        <ComboBox x:Name="ConcurrencyBox" Style="{StaticResource FormSelectStyle}" SelectionChanged="OnConcurrencyChanged">
                            <x:String>1</x:String>
                            <x:String>3</x:String>
                            <x:String>5</x:String>
                            <x:String>8</x:String>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="全局限速">
                        <ComboBox x:Name="GlobalLimitBox" Style="{StaticResource FormSelectStyle}" SelectionChanged="OnGlobalLimitChanged">
                            <x:String>不限</x:String>
                            <x:String>4 MB/s</x:String>
                            <x:String>2 MB/s</x:String>
                            <x:String>1 MB/s</x:String>
                            <x:String>256 KB/s</x:String>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="夜间不限速">
                        <controls:IosSwitch x:Name="NightSwitch" Toggled="OnNightToggled"/>
                    </controls:FormRow>
                </StackPanel>
            </Border>

            <TextBlock Margin="4,18,4,6" Style="{StaticResource GroupHeaderTextStyle}" Text="队列与计划"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <controls:FormRow x:Name="ScheduleRow" Label="计划时段" ShowChevron="True" ShowSeparator="False"/>

                    <controls:FormRow Label="失败自动重试">
                        <ComboBox x:Name="RetryBox" Style="{StaticResource FormSelectStyle}" SelectionChanged="OnRetryChanged">
                            <x:String>不重试</x:String>
                            <x:String>3 次</x:String>
                            <x:String>10 次</x:String>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="全部完成后">
                        <ComboBox x:Name="AfterBox" Style="{StaticResource FormSelectStyle}" SelectionChanged="OnAfterChanged">
                            <x:String>无操作</x:String>
                            <x:String>退出程序</x:String>
                            <x:String>休眠</x:String>
                            <x:String>关机</x:String>
                        </ComboBox>
                    </controls:FormRow>
                </StackPanel>
            </Border>

            <TextBlock Margin="4,18,4,6" Style="{StaticResource GroupHeaderTextStyle}" Text="行为"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <controls:FormRow Label="监视剪贴板" ShowSeparator="False">
                        <controls:IosSwitch x:Name="ClipboardSwitch" Toggled="OnClipboardToggled"/>
                    </controls:FormRow>

                    <controls:FormRow Label="完成后通知">
                        <controls:IosSwitch x:Name="NotifySwitch" Toggled="OnNotifyToggled"/>
                    </controls:FormRow>

                    <controls:FormRow Label="完成后校验 SHA-256">
                        <controls:IosSwitch x:Name="VerifySwitch" Toggled="OnVerifyToggled"/>
                    </controls:FormRow>

                    <controls:FormRow Label="完成后病毒扫描">
                        <controls:IosSwitch x:Name="ScanSwitch" Toggled="OnScanToggled"/>
                    </controls:FormRow>

                    <controls:FormRow Label="贴边隐藏">
                        <controls:IosSwitch x:Name="EdgeSwitch" Toggled="OnEdgeToggled"/>
                    </controls:FormRow>

                    <controls:FormRow Label="显示悬浮窗">
                        <controls:IosSwitch x:Name="IslandSwitch" Toggled="OnIslandToggled"/>
                    </controls:FormRow>

                    <controls:FormRow x:Name="BossKeyRow" Label="老板键" ShowChevron="True"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="4,6,4,0" Style="{StaticResource NoteTextStyle}"
                       Text="按下老板键后主窗口、悬浮窗、托盘图标全部消失，下载在后台继续。"/>
            <TextBlock Margin="4,6,4,0" Style="{StaticResource NoteTextStyle}"
                       Text="便携模式：设置写入程序同目录，不写注册表、不关联协议、不驻留开机项。并发数优化需手动执行，会改动系统设置。"/>

            <Button Margin="0,8,0,0" Style="{StaticResource BigPlainButtonStyle}"
                    Content="执行并发数优化…" Click="OnOptimizeClick"/>
        </StackPanel>
    </controls:SheetHost>
</UserControl>
