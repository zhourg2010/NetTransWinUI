<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- .row / .settings__card / .stat / .detail__hero base chrome -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeCardBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource RadiusCard}"/>
    </Style>

    <!-- .pill (filter row: All / Downloading / Queued / Paused / Issues) -->
    <Style x:Key="FilterPillStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="15">
                        <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}"
                                           Padding="{TemplateBinding Padding}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource BgHoverBrush}"/>
                                        <Setter Target="ContentHost.Foreground" Value="{ThemeResource Text1Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource BgLayerBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource Stroke2Brush}"/>
                                        <Setter Target="ContentHost.Foreground" Value="{ThemeResource Text1Brush}"/>
                                        <Setter Target="ContentHost.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .list__count -->
    <Style x:Key="CountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,1"/>
    </Style>
    <Style x:Key="CountBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
    </Style>

    <!-- .nav-item__badge -->
    <Style x:Key="NavBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>
    <Style x:Key="NavBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- .checkbox (custom, matches design rather than the stock CheckBox chrome) -->
    <Style x:Key="RowCheckboxStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Root"
                            Width="18" Height="18"
                            Background="{ThemeResource BgLayerBrush}"
                            BorderBrush="{ThemeResource Text3Brush}"
                            BorderThickness="1.5"
                            CornerRadius="4">
                        <Path x:Name="Check"
                              Data="{StaticResource IconCheck}"
                              Stretch="Uniform" Width="11" Height="11"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Opacity="0"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource Text2Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                        <Setter Target="Check.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
