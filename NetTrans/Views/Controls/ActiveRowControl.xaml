<UserControl
    x:Class="NetTrans.Views.Controls.ActiveRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls">

    <Border x:Name="RootBorder" Style="{StaticResource CardBorderStyle}"
            Padding="10,14,14,14"
            Tapped="OnRowTapped" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid ColumnDefinitions="28,36,*,Auto" ColumnSpacing="14">

            <CheckBox Grid.Column="0" Style="{StaticResource RowCheckboxStyle}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <controls:FileBadgeControl Grid.Column="1" Kind="{Binding Kind}" BadgeSize="36" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource RowNameTextStyle}" Text="{Binding Name}" MaxWidth="480"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconGlobe}" Width="11" Height="11" StrokeThickness="1.4" Stroke="{ThemeResource Text3Brush}"/>
                        <TextBlock Style="{StaticResource HostTextStyle}" Text="{Binding Host}"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <controls:ProgressTrackControl Grid.Column="0"
                        Percent="{Binding Percent}" Status="{Binding Status}" SegmentCount="{Binding SegmentCount}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource Text2Brush}" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <!-- normal meta line -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding NormalMetaVisibility}">
                        <TextBlock Style="{StaticResource RowMetaTextStyle}">
                            <Run Text="{Binding DoneText}"/>
                            <Run Text=" / " Foreground="{ThemeResource Text3Brush}"/>
                            <Run Text="{Binding SizeText}" Foreground="{ThemeResource Text3Brush}"/>
                        </TextBlock>
                        <Ellipse Width="3" Height="3" Fill="{ThemeResource Text4Brush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding StatusDotBrush}" Visibility="{Binding PulseVisibility}"
                                     x:Name="PulseDot"/>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusTextBrush}"/>
                        </StackPanel>
                        <Ellipse Width="3" Height="3" Fill="{ThemeResource Text4Brush}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource RowMetaTextStyle}" Text="{Binding SpeedText}"/>
                        <Ellipse Width="3" Height="3" Fill="{ThemeResource Text4Brush}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource RowMetaTextStyle}">
                            <Run Text="ETA "/><Run Text="{Binding EtaText}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource RowMetaDimTextStyle}" HorizontalAlignment="Right">
                            <Run Text="Started "/><Run Text="{Binding StartedAt}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- error meta line -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding ErrorMetaVisibility}">
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconWarning}" Width="12" Height="12" StrokeThickness="1.6" Stroke="{ThemeResource ErrBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{ThemeResource ErrBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="{ThemeResource Text4Brush}" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" Foreground="{ThemeResource ErrBrush}">
                            <Run Text="Stopped at "/><Run Text="{Binding DoneText}"/><Run Text=" of "/><Run Text="{Binding SizeText}"/>
                        </TextBlock>
                        <Button Style="{StaticResource LinkButtonStyle}" Content="Retry" HorizontalAlignment="Right"
                                Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Visibility="{Binding PauseButtonVisibility}" Command="{Binding PauseCommand}">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconPause}" Width="14" Height="14" StrokeThickness="1.6"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Visibility="{Binding ResumeButtonVisibility}" Command="{Binding ResumeCommand}">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconResume}" Width="14" Height="14" StrokeThickness="1.6" Fill="{ThemeResource Text2Brush}"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="Open folder">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFolder}" Width="14" Height="14" StrokeThickness="1.4"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="More">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Copy URL" Command="{Binding CopyUrlCommand}"/>
                            <MenuFlyoutItem Text="Open folder" Command="{Binding OpenFolderCommand}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Remove" Command="{Binding RemoveCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconMore}" Width="14" Height="14" StrokeThickness="1.6"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
