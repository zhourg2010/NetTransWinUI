<UserControl
    x:Class="NetTrans.Views.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32,24,32,12" Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"/>
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"/>
            </StackPanel>

            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <Border Grid.Column="0" Width="320" Height="32"
                        Background="{ThemeResource BgLayerBrush}" BorderBrush="{ThemeResource Stroke2Brush}"
                        BorderThickness="1" CornerRadius="{ThemeResource RadiusControl}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSearch}"
                              Width="14" Height="14" Margin="12,0,8,0" StrokeThickness="1.5" Stroke="{ThemeResource Text3Brush}"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 PlaceholderText="Search downloads" FontSize="13.5"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Grid.Column="2" Margin="0,0,10,0" BorderThickness="1" BorderBrush="{ThemeResource Stroke2Brush}"
                                CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + F" FontSize="11" Foreground="{ThemeResource Text3Brush}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" Visibility="{x:Bind ViewModel.FilterBarVisible, Mode=OneWay}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="StatusFilter" Content="All" IsChecked="True" Click="OnFilterClick" Tag="all"/>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="StatusFilter" Content="Downloading" Click="OnFilterClick" Tag="downloading"/>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="StatusFilter" Content="Queued" Click="OnFilterClick" Tag="queued"/>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="StatusFilter" Content="Paused" Click="OnFilterClick" Tag="paused"/>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="StatusFilter" Click="OnFilterClick" Tag="issues">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Issues" Foreground="{ThemeResource ErrBrush}"/>
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource ErrBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource GhostButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Newest" Click="OnSortClick" Tag="newest"/>
                            <MenuFlyoutItem Text="Name" Click="OnSortClick" Tag="name"/>
                            <MenuFlyoutItem Text="Size" Click="OnSortClick" Tag="size"/>
                            <MenuFlyoutItem Text="Progress" Click="OnSortClick" Tag="progress"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSort}" Width="14" Height="14" StrokeThickness="1.4"/>
                        <TextBlock Text="{x:Bind ViewModel.SortOrderLabel, Mode=OneWay}"/>
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" StrokeThickness="1.4"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFilter}" Width="14" Height="14" StrokeThickness="1.4"/>
                        <TextBlock Text="Filter"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="20" Fill="{ThemeResource Stroke2Brush}" Margin="4,0"/>
                <Button Style="{StaticResource GhostIconButtonStyle}">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconApp}" Width="14" Height="14" StrokeThickness="1.4"/>
                </Button>
                <Button Style="{StaticResource GhostIconButtonStyle}" Background="{ThemeResource BgSelectedBrush}">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconHamburger}" Width="14" Height="14" StrokeThickness="1.4"/>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
