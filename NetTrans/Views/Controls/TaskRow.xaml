<UserControl
    x:Class="NetTrans.Views.Controls.TaskRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls"
    xmlns:conv="using:NetTrans.Converters"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnTapped"
    RightTapped="OnRightTapped"
    SizeChanged="OnRootSizeChanged">

    <!--
        `.row`: tile, name + sub + progress, trailing readout, and the hover
        actions that slide in from the right. Dense mode ("小图") shrinks the
        tile to 22px, drops the sub line and thins the track, per `.card.dense`.
    -->
    <Grid x:Name="Surface" Background="Transparent">

        <!-- row + row::before -->
        <Border x:Name="Separator" Style="{StaticResource HairlineStyle}" Margin="59,0,0,0"/>

        <Grid x:Name="RowContent" Padding="12,9" ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- .tile -->
            <Border
                x:Name="Tile"
                Grid.Column="0"
                Width="36"
                Height="36"
                CornerRadius="{StaticResource RadiusTile}"
                Background="{x:Bind Item.TileBrush, Mode=OneWay}"
                VerticalAlignment="Center">
                <controls:StrokeIcon
                    x:Name="TileGlyph"
                    Data="{x:Bind Item.KindGlyph, Mode=OneWay}"
                    IconSize="19"
                    Thickness="1.9"
                    Foreground="White"/>
            </Border>

            <!-- .rmid -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        x:Name="NameText"
                        Style="{StaticResource RowNameTextStyle}"
                        Text="{x:Bind Item.Name, Mode=OneWay}"/>
                    <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind conv:BindingHelpers.Visible(Item.IsHighPriority), Mode=OneWay}">
                        <TextBlock Style="{StaticResource TagTextStyle}" Text="优先"/>
                    </Border>
                    <Border Style="{StaticResource NewVersionTagStyle}" Visibility="{x:Bind conv:BindingHelpers.Visible(Item.HasNewerVersion), Mode=OneWay}">
                        <TextBlock Style="{StaticResource TagTextStyle}" Foreground="{ThemeResource BlueBrush}" Text="新版本"/>
                    </Border>
                </StackPanel>

                <TextBlock
                    x:Name="SubText"
                    Margin="0,1,0,0"
                    Style="{StaticResource RowSubTextStyle}"
                    Foreground="{x:Bind Item.SubBrush, Mode=OneWay}"
                    Text="{x:Bind Item.SubText, Mode=OneWay}"/>

                <!-- .prog -->
                <Border
                    x:Name="Track"
                    Style="{StaticResource ProgressTrackStyle}"
                    Visibility="{x:Bind conv:BindingHelpers.Visible(Item.ShowProgress), Mode=OneWay}"
                    SizeChanged="OnTrackSizeChanged">
                    <Border
                        x:Name="TrackFill"
                        HorizontalAlignment="Left"
                        Width="0"
                        CornerRadius="2"
                        Background="{x:Bind Item.ProgressBrush, Mode=OneWay}"/>
                </Border>
            </StackPanel>

            <!-- .rt -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="DoneBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource BadgeTextStyle}" Text="完成"/>
                </Border>
                <TextBlock
                    x:Name="TrailingText"
                    MinWidth="34"
                    Style="{StaticResource RowPercentTextStyle}"
                    Text="{x:Bind Item.TrailingText, Mode=OneWay}"/>
                <controls:StrokeIcon
                    Data="{StaticResource IconChevron}"
                    IconSize="13"
                    Thickness="2.4"
                    Foreground="{ThemeResource Label3Brush}"/>
            </StackPanel>
        </Grid>

        <!-- .swipe -->
        <StackPanel
            x:Name="Swipe"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            SizeChanged="OnSwipeSizeChanged">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="SwipeOffset"/>
            </StackPanel.RenderTransform>

            <Button
                x:Name="ToggleButton"
                Style="{StaticResource SwipeButtonStyle}"
                Background="{ThemeResource GrayBrush}"
                Click="OnToggleClick">
                <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <controls:StrokeIcon
                        x:Name="ToggleGlyph"
                        Data="{x:Bind Item.ToggleGlyph, Mode=OneWay}"
                        IsFilled="True"
                        IconSize="17"
                        Foreground="White"/>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{x:Bind Item.ToggleLabel, Mode=OneWay}"/>
                </StackPanel>
            </Button>

            <Button
                Style="{StaticResource SwipeButtonStyle}"
                Background="{ThemeResource RedBrush}"
                Click="OnRemoveClick">
                <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <controls:StrokeIcon
                        x:Name="RemoveGlyph"
                        Data="{StaticResource IconTrash}"
                        IconSize="17"
                        Foreground="White"/>
                    <TextBlock
                        x:Name="RemoveLabel"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="删除"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
