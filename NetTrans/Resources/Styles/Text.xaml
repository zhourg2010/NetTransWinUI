<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every size/weight/tracking pair the handoff specifies, named after the
         CSS class it comes from. Numbers use tabular figures throughout, per
         "数字一律 font-variant-numeric: tabular-nums". -->

    <!--
        LineHeight, not TextLineBounds="Tight".

        Tight sizes a line to the ink of the glyphs that happen to be in it, so
        the same style measured 11px for a Latin name and more for a CJK one,
        and a stack of name + sub + progress came out 31px where the design's
        is 44 -- the row collapsed from 62px to 54px and the sub line's
        descenders painted straight through the progress bar. Every line box
        below is the height the handoff's own render reports for that class,
        with BlockLineHeight so the box is exactly that and nothing else.
    -->
    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings"/>
    </Style>

    <!-- The handoff sets font-variant-numeric: tabular-nums on every number.
         WinUI has no font-feature API on TextBlock, but Segoe UI Variable's
         lining figures are already fixed-width, so numeric readouts stay
         aligned; this style exists to mark them and to keep one place to fix
         if the UI font is ever swapped for a proportional-figure face. -->
    <Style x:Key="TabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"/>

    <!-- .nav__t -->
    <Style x:Key="NavTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="-13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>


    <!-- .rname -->
    <Style x:Key="RowNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="CharacterSpacing" Value="-10"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- .rsub -->
    <Style x:Key="RowSubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- .rpct -->
    <Style x:Key="RowPercentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- .ghdr -->
    <Style x:Key="GroupHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="CharacterSpacing" Value="21"/>
    </Style>

    <!-- .flabel -->
    <Style x:Key="FormLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CharacterSpacing" Value="-13"/>
    </Style>

    <!-- .fval -->
    <Style x:Key="FormValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>



    <!-- .fnote -->
    <Style x:Key="NoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="LineHeight" Value="17.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- .shead h2 -->
    <Style x:Key="SheetTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="-18"/>
    </Style>

    <!-- .ring__p -->
    <Style x:Key="RingPercentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="-33"/>
        <Setter Property="LineHeight" Value="27"/>
        <Setter Property="TextLineBounds" Value="TrimToBaseline"/>
    </Style>

    <!-- .ring__s / .ringcap -->
    <Style x:Key="RingSubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RingCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- .tag2 -->
    <Style x:Key="TagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="LineHeight" Value="12"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="10"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
    </Style>

    <!-- .badge -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="10"/>
        <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}"/>
    </Style>

    <!-- .conn__n / .conn__v / .logrow -->
    <Style x:Key="MetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource Label2Brush}"/>
    </Style>

    <Style x:Key="MetaDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource Label3Brush}"/>
    </Style>

    <!-- .newver__m b -->
    <Style x:Key="NoticeTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="-13"/>
    </Style>


</ResourceDictionary>
