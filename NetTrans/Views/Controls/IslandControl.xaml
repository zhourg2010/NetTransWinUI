<UserControl
    x:Class="NetTrans.Views.Controls.IslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnTapped">

    <!--
        `.island`: a black capsule showing total progress and throughput, which
        grows on hover to add the upload/average line and a 26-bar sparkline.
    -->
    <Grid x:Name="Surface" Background="{ThemeResource IslandBrush}">
        <Grid x:Name="Layout" Padding="14,0" RowSpacing="7" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- .isl__ring -->
                <Viewbox Width="19" Height="19" VerticalAlignment="Center">
                    <Canvas Width="22" Height="22">
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="16" Height="16"
                                 Stroke="#40FFFFFF" StrokeThickness="3"/>
                        <Ellipse x:Name="Arc" Canvas.Left="3" Canvas.Top="3" Width="16" Height="16"
                                 Stroke="#0A84FF" StrokeThickness="3" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Viewbox>

                <!-- .isl__v -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SpeedValue" FontSize="14" FontWeight="SemiBold" CharacterSpacing="-14" Foreground="White"/>
                    <TextBlock x:Name="SpeedUnit" Margin="2,0,0,0" FontSize="11" FontWeight="Medium" Foreground="White" Opacity="0.6" VerticalAlignment="Bottom"/>
                </StackPanel>

                <!-- .isl__sub -->
                <TextBlock
                    x:Name="Subtitle"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="White"
                    Opacity="0.6"
                    Visibility="Collapsed"/>
            </Grid>

            <!-- .spark -->
            <Grid x:Name="Spark" Grid.Row="1" Height="12" ColumnSpacing="2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
