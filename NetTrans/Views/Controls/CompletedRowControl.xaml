<UserControl
    x:Class="NetTrans.Views.Controls.CompletedRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls">

    <Border x:Name="RootBorder" Style="{StaticResource CardBorderStyle}"
            Padding="10,10,14,10" Tapped="OnRowTapped" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid ColumnDefinitions="28,32,*,Auto" ColumnSpacing="14">

            <CheckBox Grid.Column="0" Style="{StaticResource RowCheckboxStyle}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <controls:FileBadgeControl Grid.Column="1" Kind="{Binding Kind}" BadgeSize="32" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource RowNameTextStyle}" Text="{Binding Name}" MaxWidth="480"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconGlobe}" Width="11" Height="11" StrokeThickness="1.4" Stroke="{ThemeResource Text3Brush}"/>
                        <TextBlock Style="{StaticResource HostTextStyle}" Text="{Binding Host}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconCheck}" Width="11" Height="11" StrokeThickness="2" Stroke="{ThemeResource OkBrush}"/>
                        <TextBlock Style="{StaticResource RowMetaTextStyle}" Text="Completed"/>
                    </StackPanel>
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource Text4Brush}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource RowMetaTextStyle}" Text="{Binding SizeText}"/>
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource Text4Brush}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource RowMetaTextStyle}" Text="{Binding Duration}"/>
                    <TextBlock Style="{StaticResource RowMetaDimTextStyle}" Text="{Binding CompletedWhen}" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFolder}" Width="14" Height="14" StrokeThickness="1.4"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveCommand}">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconMore}" Width="14" Height="14" StrokeThickness="1.6"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
