<UserControl
    x:Class="NetTrans.Views.Sheets.TorrentSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls">

    <controls:SheetHost
        x:Name="Host"
        Title="种子 / 磁力链"
        RightLabel="下载"
        IsRightEnabled="False"
        Cancelled="OnCancelled"
        Confirmed="OnConfirmed">

        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <controls:FormRow Label="" ShowSeparator="False">
                        <TextBox
                            x:Name="LinkBox"
                            Width="420"
                            Style="{StaticResource FormTextBoxLeftStyle}"
                            PlaceholderText="magnet:?xt=urn:btih:… 或种子文件路径"
                            TextChanged="OnLinkChanged"/>
                    </controls:FormRow>

                    <controls:FormRow x:Name="FileRow" Label="种子文件" ShowChevron="True" Tapped="OnPickFileTapped"/>

                    <controls:FormRow x:Name="SavePathRow" Label="保存到" ShowChevron="True" Tapped="OnSavePathTapped"/>

                    <controls:FormRow Label="顺序下载">
                        <controls:IosSwitch x:Name="SequentialSwitch"/>
                    </controls:FormRow>

                    <controls:FormRow Label="上传限速">
                        <ComboBox x:Name="UploadLimitBox" Style="{StaticResource FormSelectStyle}">
                            <x:String>不限</x:String>
                            <x:String>128 KB/s</x:String>
                            <x:String>512 KB/s</x:String>
                            <x:String>1 MB/s</x:String>
                            <x:String>4 MB/s</x:String>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="做种限制">
                        <ComboBox x:Name="SeedingBox" Style="{StaticResource FormSelectStyle}">
                            <x:String>一直做种</x:String>
                            <x:String>分享率 1.0</x:String>
                            <x:String>分享率 2.0</x:String>
                            <x:String>做种 60 分钟</x:String>
                            <x:String>下完即停</x:String>
                        </ComboBox>
                    </controls:FormRow>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="Summary"
                Margin="4,10,4,0"
                Style="{StaticResource NoteTextStyle}"
                Text="磁力链需要先向 peer 索取元数据，文件列表会在开始后出现。"/>

            <Border
                Margin="0,16,0,0"
                Style="{StaticResource NoticeStyle}"
                Background="{ThemeResource Fill2Brush}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource NoticeTitleTextStyle}" Text="关于 DHT 与私有种子"/>
                    <TextBlock
                        Style="{StaticResource NoteTextStyle}"
                        Text="DHT 与 PEX 尚未实现，所以没有 tracker 的磁力链暂时无法找到 peer。私有种子本来就只走 tracker，不受影响。"/>
                    <TextBlock
                        Style="{StaticResource NoteTextStyle}"
                        Text="上传是真实统计并上报 tracker 的。PT 站还需要把客户端加入白名单，NetTrans 目前不在任何站点的名单里。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </controls:SheetHost>
</UserControl>
