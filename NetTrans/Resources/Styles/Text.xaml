<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Numeric fields (bytes, speeds, percentages, timers) use tabular
         figures so columns of numbers don't jitter as digits change. -->
    <Style x:Key="TabularTextStyle" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- .page-header__title -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="-12"/>
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- .list__sectionhead / .detail__sectionhead / .navrail__heading -->
    <Style x:Key="SectionHeadTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="10"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
    </Style>

    <Style x:Key="UppercaseSectionHeadStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="70"/>
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}"/>
    </Style>

    <!-- .row__name -->
    <Style x:Key="RowNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="-5"/>
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- .row__host / .detail__sub -->
    <Style x:Key="HostTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}"/>
    </Style>

    <!-- .row__meta -->
    <Style x:Key="RowMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
    </Style>

    <Style x:Key="RowMetaDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RowMetaTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}"/>
    </Style>

    <!-- .empty__title / .empty__sub -->
    <Style x:Key="EmptyTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EmptySubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="MaxWidth" Value="460"/>
    </Style>

</ResourceDictionary>
