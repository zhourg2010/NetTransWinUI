<ContentDialog
    x:Class="NetTrans.Views.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:NetTrans.Converters"
    Style="{StaticResource AppContentDialogStyle}"
    MinWidth="880" MaxWidth="880" MinHeight="640" MaxHeight="640"
    RequestedTheme="{x:Bind Shell.AppTheme, Mode=OneWay}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Style="{StaticResource ModalHeadBorderStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource ModalTitleTextStyle}" Text="Settings"/>
                    <TextBlock Style="{StaticResource ModalSubTextStyle}" Text="Preferences for NetTrans" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnCloseClick">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconClose}" Width="14" Height="14" StrokeThickness="1.6"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <StackPanel Grid.Column="0" Background="{ThemeResource BgSubtleBrush}" Padding="6,10" Spacing="2"
                        BorderThickness="0,0,1,0" BorderBrush="{ThemeResource Stroke1Brush}">
                <RadioButton x:Name="NavGeneral" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="general">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSettings}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="General" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="NavDownloads" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="downloads">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconDownload}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="Downloads" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="NavNetwork" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="network">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconGlobe}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="Network" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="NavSchedule" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="schedule">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSchedule}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="Schedule" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="NavBrowsers" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="browsers">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconApp}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="Browser capture" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="NavAdvanced" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="advanced">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconApp}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="Advanced" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="NavAbout" Style="{StaticResource RailNavItemStyle}" GroupName="SettingsNav" Click="OnNavClick" Tag="about">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconWarning}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="About" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
            </StackPanel>

            <ScrollViewer Grid.Column="1" Padding="28,22">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                    <!-- General -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'general'), Mode=OneWay}"
                                x:Name="GeneralPage">
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="APPEARANCE"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="App theme" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Follow Windows or pick a fixed mode" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Background="{ThemeResource BgSubtleBrush}"
                                                BorderThickness="1" BorderBrush="{ThemeResource Stroke2Brush}" CornerRadius="4" Padding="2">
                                        <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource SegmentedButtonStyle}" GroupName="Theme" Content="Light" Click="OnThemeClick" Tag="light"/>
                                        <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource SegmentedButtonStyle}" GroupName="Theme" Content="Dark" Click="OnThemeClick" Tag="dark"/>
                                        <RadioButton x:Name="ThemeAutoRadio" Style="{StaticResource SegmentedButtonStyle}" GroupName="Theme" Content="System" Click="OnThemeClick" Tag="auto"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Accent color" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Used for progress bars and primary actions" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" x:Name="SwatchesPanel" Orientation="Horizontal" Spacing="6"/>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Compact density" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Show more downloads at once" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DensityToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}" Click="OnDensityClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="STARTUP"/>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Launch at sign-in" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Run NetTrans in the background after login" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.LaunchAtSignIn, Mode=TwoWay}"/>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Resume interrupted downloads" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Recommended" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.ResumeInterruptedDownloads, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Downloads -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'downloads'), Mode=OneWay}">
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="DEFAULT BEHAVIOR"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Default save location" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Settings.DefaultSavePath, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFolder}" Width="14" Height="14" StrokeThickness="1.4"/>
                                            <TextBlock Text="Change"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Maximum simultaneous downloads" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Recommended: 4 for most connections" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="90"
                                              SelectedValue="{x:Bind Settings.MaxSimultaneousDownloads, Mode=TwoWay}">
                                        <x:Int32>4</x:Int32>
                                        <x:Int32>8</x:Int32>
                                        <x:Int32>16</x:Int32>
                                    </ComboBox>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Segments per file" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="More segments may speed up downloads from fast servers" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="90"
                                              SelectedValue="{x:Bind Settings.SegmentsPerFile, Mode=TwoWay}">
                                        <x:Int32>8</x:Int32>
                                        <x:Int32>16</x:Int32>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="AFTER COMPLETION"/>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Verify checksums when available" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="SHA-256, MD5" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.VerifyChecksums, Mode=TwoWay}"/>
                                </Grid>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Auto-extract archives" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text=".zip, .7z, .tar.gz" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.AutoExtractArchives, Mode=TwoWay}"/>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Notify on completion" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Toast notifications via Action Center" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.NotifyOnCompletion, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Network -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'network'), Mode=OneWay}">
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="BANDWIDTH"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Global download limit" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Applies across all active downloads" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="120">
                                        <ComboBoxItem Content="No limit" IsSelected="True"/>
                                        <ComboBoxItem Content="5 MB/s"/>
                                        <ComboBoxItem Content="10 MB/s"/>
                                        <ComboBoxItem Content="25 MB/s"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Throttle on metered networks" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Limit speed when on a metered connection" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="120">
                                        <ComboBoxItem Content="1 MB/s" IsSelected="True"/>
                                        <ComboBoxItem Content="2 MB/s"/>
                                        <ComboBoxItem Content="Pause downloads"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="PROXY"/>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Proxy mode" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="System proxy, manual, or off" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="150">
                                    <ComboBoxItem Content="Use system proxy" IsSelected="True"/>
                                    <ComboBoxItem Content="Manual"/>
                                    <ComboBoxItem Content="Off"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Schedule -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'schedule'), Mode=OneWay}">
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="OFF-PEAK WINDOW"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Enable off-peak scheduling" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Downloads marked &quot;Schedule for off-peak&quot; start automatically inside the window" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.ScheduleEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Window opens" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Scheduled transfers begin at this time" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="110" SelectedValuePath="Content"
                                              SelectedValue="{x:Bind Settings.OffPeakStart, Mode=TwoWay}">
                                        <ComboBoxItem Content="22:00"/>
                                        <ComboBoxItem Content="23:00"/>
                                        <ComboBoxItem Content="00:00"/>
                                        <ComboBoxItem Content="01:00"/>
                                        <ComboBoxItem Content="02:00"/>
                                        <ComboBoxItem Content="03:00"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Window closes" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Running scheduled transfers pause again after this time" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="110" SelectedValuePath="Content"
                                              SelectedValue="{x:Bind Settings.OffPeakEnd, Mode=TwoWay}">
                                        <ComboBoxItem Content="05:00"/>
                                        <ComboBoxItem Content="06:00"/>
                                        <ComboBoxItem Content="07:00"/>
                                        <ComboBoxItem Content="08:00"/>
                                        <ComboBoxItem Content="09:00"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid Padding="18,16" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSchedule}" Width="16" Height="16" StrokeThickness="1.4" Stroke="{ThemeResource Text3Brush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap"
                                           Text="Queue a download for off-peak from the New Download dialog: set Start to &quot;Schedule for off-peak&quot;. It waits on the Scheduled page until the window opens."/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Browser capture -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'browsers'), Mode=OneWay}">
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="CAPTURE DOWNLOADS FROM"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Microsoft Edge" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Intercept downloads started in Edge" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.CaptureEdge, Mode=TwoWay}"/>
                                </Grid>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Google Chrome" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Intercept downloads started in Chrome" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.CaptureChrome, Mode=TwoWay}"/>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mozilla Firefox" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Intercept downloads started in Firefox" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.CaptureFirefox, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="BEHAVIOR"/>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show a notification when a download is captured" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Lets you send it back to the browser if you didn't want NetTrans to take it" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.NotifyOnCapture, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'advanced'), Mode=OneWay}">
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="TRANSFER ENGINE"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Max connections per server" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Higher values can be faster but some servers throttle aggressive clients" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBoxStyle}" Width="90"
                                              SelectedValue="{x:Bind Settings.MaxConnectionsPerServer, Mode=TwoWay}">
                                        <x:Int32>8</x:Int32>
                                        <x:Int32>16</x:Int32>
                                        <x:Int32>32</x:Int32>
                                    </ComboBox>
                                </Grid>
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Pre-allocate files on disk" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reserves the full file size up front to reduce fragmentation" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggleStyle}" IsChecked="{x:Bind Settings.PreallocateFiles, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource ModalPageHeadTextStyle}" Text="IDENTIFICATION"/>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid Padding="18,16" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Custom user agent" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Leave empty to use the default" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Width="240"
                                         PlaceholderText="Mozilla/5.0 …"
                                         Text="{x:Bind Settings.UserAgent, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(Settings.CurrentPage, 'about'), Mode=OneWay}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid Padding="18,20" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14" VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{ThemeResource AccentColor}" Opacity="0.12"/>
                                    </Border.Background>
                                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconDownload}" Width="28" Height="28" StrokeThickness="1.4" Stroke="{ThemeResource AccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="NetTrans" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12.5" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="Framework" FontSize="12.5" Foreground="{ThemeResource Text3Brush}"/>
                                    <TextBlock Grid.Column="1" Text="WinUI 3 · Windows App SDK" FontSize="12.5"/>
                                </Grid>
                                <Grid Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="Targets" FontSize="12.5" Foreground="{ThemeResource Text3Brush}"/>
                                    <TextBlock Grid.Column="1" Text=".NET 8 · .NET 10 (x86 / x64 / ARM64)" FontSize="12.5"/>
                                </Grid>
                                <Grid Padding="18,14" ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="Design" FontSize="12.5" Foreground="{ThemeResource Text3Brush}"/>
                                    <TextBlock Grid.Column="1" Text="Fluent / Windows 11 · from a Claude Design handoff" FontSize="12.5"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ModalFootBorderStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Changes are saved automatically." FontSize="12" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryAccentSmallButtonStyle}" Content="Done" Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
