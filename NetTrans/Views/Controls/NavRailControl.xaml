<UserControl
    x:Class="NetTrans.Views.Controls.NavRailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NetTrans.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="260"
    Width="{ThemeResource NavRailWidth}">

    <Grid Background="{ThemeResource BgAcrylicBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="6" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource Stroke1Brush}"/>

        <Button Grid.Row="0" Style="{StaticResource IconButtonStyle}"
                Width="40" Height="40" Margin="6,8,0,4" HorizontalAlignment="Left">
            <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconHamburger}" Width="18" Height="18" StrokeThickness="1.4"/>
        </Button>

        <Button Grid.Row="1" Style="{StaticResource PrimaryAccentButtonStyle}"
                Margin="6,4,6,8" HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.OpenNewDownloadCommand, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconAdd}" Width="14" Height="14" Stroke="White" StrokeThickness="1.8"/>
                <TextBlock Text="New download"/>
            </StackPanel>
        </Button>

        <StackPanel Grid.Row="2" Margin="6,0" Spacing="2">
            <RadioButton x:Name="ActiveItem" Style="{StaticResource RailNavItemStyle}" GroupName="NavSection" IsChecked="True"
                         Click="OnSectionClick" Tag="active">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconDownload}" Width="16" Height="16" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Active" FontSize="14" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Style="{StaticResource NavBadgeStyle}">
                        <TextBlock Style="{StaticResource NavBadgeTextStyle}" Text="{x:Bind ViewModel.Engine.ActiveDownloads.Count, Mode=OneWay}"/>
                    </Border>
                </Grid>
            </RadioButton>

            <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavSection" Click="OnSectionClick" Tag="completed">
                <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconCheck}" Width="16" Height="16" Margin="0,0,12,0" StrokeThickness="1.6"/>
                    <TextBlock Grid.Column="1" Text="Completed" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
            </RadioButton>

            <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavSection" Click="OnSectionClick" Tag="scheduled">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSchedule}" Width="16" Height="16" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Scheduled" FontSize="14" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Style="{StaticResource NavBadgeStyle}">
                        <TextBlock Style="{StaticResource NavBadgeTextStyle}" Text="3"/>
                    </Border>
                </Grid>
            </RadioButton>

            <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavSection" Click="OnSectionClick" Tag="history">
                <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconHistory}" Width="16" Height="16" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="History" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
            </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="6,0">
            <TextBlock Style="{StaticResource NavHeadingTextStyle}" Text="CATEGORIES"/>
            <StackPanel Spacing="2">
                <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavCategory">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconApp}" Width="16" Height="16" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Apps &amp; installers" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="12.4 GB" FontSize="11" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavCategory">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconVideo}" Width="16" Height="16" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Video" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="84.1 GB" FontSize="11" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavCategory">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconMusic}" Width="16" Height="16" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Music" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="6.2 GB" FontSize="11" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavCategory">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconDoc}" Width="16" Height="16" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Documents" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="1.1 GB" FontSize="11" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource RailNavItemStyle}" GroupName="NavCategory">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconArchive}" Width="16" Height="16" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Archives" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="22.0 GB" FontSize="11" Foreground="{ThemeResource Text3Brush}" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
            </StackPanel>
        </StackPanel>

        <RadioButton Grid.Row="5" Style="{StaticResource RailNavItemStyle}" GroupName="NavSection" Margin="6,4,6,8" Click="OnSectionClick" Tag="settings">
            <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSettings}" Width="16" Height="16" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="Settings" FontSize="14" VerticalAlignment="Center"/>
            </Grid>
        </RadioButton>
    </Grid>
</UserControl>
