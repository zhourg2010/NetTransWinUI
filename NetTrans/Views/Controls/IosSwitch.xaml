<UserControl
    x:Class="NetTrans.Views.Controls.IosSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Width="51"
    Height="31">

    <!-- `.sw`: 51x31 track, 27px knob travelling 2 -> 22 over .24s. -->
    <Border
        x:Name="Track"
        Background="{ThemeResource Fill2Brush}"
        CornerRadius="16"
        Tapped="OnTapped">

        <Border
            x:Name="Knob"
            Width="27"
            Height="27"
            Margin="0,2,0,2"
            HorizontalAlignment="Left"
            Background="White"
            CornerRadius="14"
            ui:Effects.Shadow="{StaticResource SwitchKnobShadow}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="KnobOffset" X="2"/>
            </Border.RenderTransform>
        </Border>
    </Border>
</UserControl>
