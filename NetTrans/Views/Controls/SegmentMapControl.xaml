<UserControl
    x:Class="NetTrans.Views.Controls.SegmentMapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 4-column wrap of mini progress cells, built entirely in code-behind:
         each cell needs its own two-column Star Grid to size its fill by
         percent (see ProgressTrackControl), which is simplest to construct
         directly rather than fight DataTemplate/converter ceremony for a
         fixed, small (<=16) item count. -->
    <Grid x:Name="RootGrid" ColumnSpacing="6" RowSpacing="6"/>
</UserControl>
