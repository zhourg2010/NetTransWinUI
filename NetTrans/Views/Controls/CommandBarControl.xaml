<UserControl
    x:Class="NetTrans.Views.Controls.CommandBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="{ThemeResource CommandBarHeight}">

    <Grid Background="{ThemeResource BgAcrylicBrush}" Padding="16,0" ColumnDefinitions="*,Auto">
        <Border Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}"/>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Style="{StaticResource CommandBarPrimaryButtonStyle}" Command="{x:Bind ViewModel.OpenNewDownloadCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconAdd}" Width="15" Height="15" Stroke="White" StrokeThickness="1.8"/>
                    <TextBlock Text="New"/>
                </StackPanel>
            </Button>
            <Rectangle Width="1" Height="20" Fill="{ThemeResource Stroke2Brush}" Margin="4,0"/>

            <Button Style="{StaticResource CommandBarTextButtonStyle}" Command="{x:Bind ViewModel.PauseAllCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconPause}" Width="15" Height="15" StrokeThickness="1.6"/>
                    <TextBlock Text="Pause all"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CommandBarTextButtonStyle}" Command="{x:Bind ViewModel.ResumeAllCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconResume}" Width="15" Height="15" Fill="{ThemeResource Text1Brush}" StrokeThickness="1.6"/>
                    <TextBlock Text="Resume all"/>
                </StackPanel>
            </Button>
            <Rectangle Width="1" Height="20" Fill="{ThemeResource Stroke2Brush}" Margin="4,0"/>

            <Button Style="{StaticResource CommandBarTextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconTrash}" Width="15" Height="15" StrokeThickness="1.5"/>
                    <TextBlock Text="Remove"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CommandBarTextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFolder}" Width="15" Height="15" StrokeThickness="1.5"/>
                    <TextBlock Text="Open folder"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CommandBarTextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSchedule}" Width="15" Height="15" StrokeThickness="1.5"/>
                    <TextBlock Text="Schedule"/>
                </StackPanel>
            </Button>
            <Rectangle Width="1" Height="20" Fill="{ThemeResource Stroke2Brush}" Margin="4,0"/>

            <Button Style="{StaticResource CommandBarTextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSort}" Width="14" Height="14" StrokeThickness="1.5"/>
                    <TextBlock Text="Sort"/>
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconChevronDown}" Width="11" Height="11" StrokeThickness="1.5"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CommandBarTextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFilter}" Width="14" Height="14" StrokeThickness="1.5"/>
                    <TextBlock Text="Filter"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{ThemeResource BgLayerBrush}" CornerRadius="999" Padding="12,0" Height="28"
                    Visibility="{x:Bind ViewModel.SelectedCountVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"
                               Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Padding="6,0">
                <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSpeed}" Width="14" Height="14" StrokeThickness="1.5" Stroke="{ThemeResource Text2Brush}"/>
                <StackPanel>
                    <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{ThemeResource Text1Brush}"
                               Text="{x:Bind ViewModel.TotalSpeedText, Mode=OneWay}"/>
                    <TextBlock FontSize="11" Foreground="{ThemeResource Text3Brush}">
                        <Run Text="↓ total · "/>
                        <Run Text="{x:Bind ViewModel.MonthlyTotalText, Mode=OneWay}"/>
                        <Run Text=" this month"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <Rectangle Width="1" Height="20" Fill="{ThemeResource Stroke2Brush}"/>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Throttle" FontSize="13" Foreground="{ThemeResource Text2Brush}" VerticalAlignment="Center"/>
                <ToggleButton Style="{StaticResource PillToggleStyle}"
                              IsChecked="{x:Bind ViewModel.IsThrottled, Mode=OneWay}"
                              Click="OnThrottleClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
