<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- .card: white group container, 10px radius, children clipped -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
    </Style>

    <!-- the .5px hairline used for `row + row::before`, `.nav` bottom, `.bar` top -->
    <Style x:Key="HairlineStyle" TargetType="Border">
        <Setter Property="Height" Value="0.5"/>
        <Setter Property="Background" Value="{ThemeResource SepBrush}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- .tag2: 优先 -->
    <Style x:Key="TagStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Fill2Brush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- .tag2.new: 新版本 -->
    <Style x:Key="NewVersionTagStyle" TargetType="Border" BasedOn="{StaticResource TagStyle}">
        <Setter Property="Background" Value="{ThemeResource BlueWash14Brush}"/>
    </Style>

    <!-- .badge: 完成 -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GreenBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- .newver: the blue "服务器上有更新版本" notice -->
    <Style x:Key="NoticeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BlueWash09Brush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusNotice}"/>
        <Setter Property="Padding" Value="11,10"/>
    </Style>

    <!-- .prog: the 3px track under a row (2px in dense mode) -->
    <Style x:Key="ProgressTrackStyle" TargetType="Border">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Background" Value="{ThemeResource Fill2Brush}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

</ResourceDictionary>
