<UserControl
    x:Class="NetTrans.Views.Controls.TitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="{ThemeResource TitleBarHeight}">

    <Grid BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Padding="12,0" VerticalAlignment="Center">
            <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconDownload}"
                  Width="14" Height="14" StrokeThickness="1.6" Stroke="{ThemeResource AccentBrush}"/>
            <TextBlock Text="NetTrans" FontSize="12" Foreground="{ThemeResource Text2Brush}"/>
        </StackPanel>

        <!-- Draggable region; MainWindow.SetTitleBar() targets this element. -->
        <Rectangle x:Name="DragRegion" Grid.Column="1" Fill="Transparent"/>

        <!-- System AppWindow.TitleBar handles the real caption buttons via ExtendsContentIntoTitleBar;
             this StackPanel is left empty on purpose so Windows draws them at the far right. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="CaptionButtonsPlaceholder" Width="138"/>
    </Grid>
</UserControl>
