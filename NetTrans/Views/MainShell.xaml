<UserControl
    x:Class="NetTrans.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls"
    xmlns:conv="using:NetTrans.Converters"
    xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:ui="using:CommunityToolkit.WinUI"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">

    <!-- `.frame.win2`: nav, segmented control, folded list, seven-icon toolbar. -->
    <Grid Background="{ThemeResource GroupBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="49"/>
        </Grid.RowDefinitions>

        <!-- ── .nav ──────────────────────────────────────────────────────── -->
        <Grid
            x:Name="NavBar"
            Grid.Row="0"
            Background="{ThemeResource NavBrush}"
            Padding="14,0"
            PointerPressed="OnNavPointerPressed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- .navleft: the three dots plus the active category chip -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse Width="11" Height="11" Fill="{ThemeResource DotRedBrush}" PointerPressed="OnCloseDotPressed"/>
                <Ellipse Width="11" Height="11" Fill="{ThemeResource DotYellowBrush}" PointerPressed="OnMinimizeDotPressed"/>
                <Ellipse Width="11" Height="11" Fill="{ThemeResource DotGreenBrush}" PointerPressed="OnZoomDotPressed"/>

                <Button
                    Margin="1,0,0,0"
                    Style="{StaticResource FilterChipStyle}"
                    Visibility="{x:Bind conv:BindingHelpers.Visible(ViewModel.HasCategoryFilter), Mode=OneWay}"
                    Command="{x:Bind ViewModel.ClearCategoryCommand}"
                    ToolTipService.ToolTip="清除分类筛选">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}"/>
                        <controls:StrokeIcon Data="{StaticResource IconClose}" IconSize="10" Thickness="2.6" Foreground="White" Opacity="0.8"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- .nav__t / .navsearch -->
            <TextBlock
                x:Name="NavTitle"
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                TextAlignment="Center"
                Style="{StaticResource NavTitleTextStyle}"
                Visibility="{x:Bind conv:BindingHelpers.Collapsed(ViewModel.IsSearchOpen), Mode=OneWay}">
                <Run Text="下载"/>
                <Run
                    x:Name="NavTitleDetail"
                    Foreground="{ThemeResource Label2Brush}"
                    FontWeight="Normal"
                    Text="{x:Bind ViewModel.TitleDetail, Mode=OneWay}"/>
            </TextBlock>

            <TextBox
                x:Name="NavSearch"
                Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                Style="{StaticResource NavSearchBoxStyle}"
                PlaceholderText="搜索任务"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="OnSearchLostFocus"
                Visibility="{x:Bind conv:BindingHelpers.Visible(ViewModel.IsSearchOpen), Mode=OneWay}"/>

            <!-- .navright -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="搜索" Click="OnSearchClick">
                    <controls:StrokeIcon Data="{StaticResource IconSearch}" IconSize="17" Thickness="2.1"/>
                </Button>
                <Button x:Name="ViewMenuButton" Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="显示与排序" Click="OnViewMenuClick">
                    <controls:StrokeIcon Data="{StaticResource IconGauge}" IconSize="18" Thickness="2"/>
                </Button>
                <Button x:Name="AddMenuButton" Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="新建" Click="OnAddMenuClick">
                    <controls:StrokeIcon Data="{StaticResource IconPlus}" IconSize="19" Thickness="2.1"/>
                </Button>
            </StackPanel>

            <Border Grid.ColumnSpan="3" Style="{StaticResource HairlineStyle}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- ── .seg ──────────────────────────────────────────────────────── -->
        <controls:SegmentedControl
            x:Name="Tabs"
            Grid.Row="1"
            Margin="16,0,16,12"
            SelectionChanged="OnTabChanged"/>

        <!-- ── .scroll ───────────────────────────────────────────────────── -->
        <ScrollViewer
            Grid.Row="2"
            Padding="16,0,16,4"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Disabled">

            <Grid>
                <Border x:Name="ListCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ItemsRepeater
                            x:Name="Rows"
                            ItemsSource="{x:Bind ViewModel.VisibleTasks, Mode=OneWay}"
                            ElementPrepared="OnRowPrepared">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <controls:TaskRow/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- .morerow -->
                        <Button
                            x:Name="FoldButton"
                            Style="{StaticResource MoreRowButtonStyle}"
                            Visibility="{x:Bind conv:BindingHelpers.Visible(ViewModel.CanFold), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleFoldCommand}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource BlueWash10Brush}">
                                    <controls:StrokeIcon
                                        x:Name="FoldGlyph"
                                        Data="{StaticResource IconDown}"
                                        IconSize="15"
                                        Thickness="2.2"
                                        RenderTransformOrigin="0.5,0.5">
                                        <controls:StrokeIcon.RenderTransform>
                                            <RotateTransform x:Name="FoldGlyphRotation"/>
                                        </controls:StrokeIcon.RenderTransform>
                                    </controls:StrokeIcon>
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13.5"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource BlueBrush}"
                                    Text="{x:Bind ViewModel.FoldLabel, Mode=OneWay}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,34"
                    HorizontalAlignment="Center"
                    Style="{StaticResource NoteTextStyle}"
                    Text="没有符合条件的任务"
                    Visibility="{x:Bind conv:BindingHelpers.Visible(ViewModel.IsEmpty), Mode=OneWay}"/>
            </Grid>
        </ScrollViewer>

        <!-- ── .bar: the seven ───────────────────────────────────────────── -->
        <Grid x:Name="Toolbar" Grid.Row="3" Background="{ThemeResource BarBrush}" Padding="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="新建下载" Click="OnAddMenuClick" x:Name="ToolbarAddButton">
                <controls:StrokeIcon Data="{StaticResource IconPlus}" IconSize="22" Thickness="2"/>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ToggleAllTooltip, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleAllCommand}">
                <controls:StrokeIcon x:Name="ToggleAllGlyph" IsFilled="True" IconSize="22"/>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RemoveTooltip, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RemoveSelectedCommand}">
                <controls:StrokeIcon Data="{StaticResource IconTrash}" IconSize="22"/>
            </Button>

            <Button Grid.Column="6" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="打开文件夹"
                    IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}"
                    Command="{x:Bind ViewModel.OpenFolderCommand}">
                <controls:StrokeIcon Data="{StaticResource IconFolder}" IconSize="22"/>
            </Button>

            <Button Grid.Column="8" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="视频嗅探"
                    Command="{x:Bind ViewModel.OpenSheetCommand}" CommandParameter="sniff">
                <controls:StrokeIcon Data="{StaticResource IconFilm}" IconSize="22"/>
            </Button>

            <prim:ToggleButton Grid.Column="10" Style="{StaticResource ToolToggleStyle}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.InspectorTooltip, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.ShowInspector, Mode=TwoWay}">
                <controls:StrokeIcon Data="{StaticResource IconInfo}" IconSize="22"/>
            </prim:ToggleButton>

            <Button Grid.Column="12" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="设置"
                    Command="{x:Bind ViewModel.OpenSheetCommand}" CommandParameter="prefs">
                <controls:StrokeIcon Data="{StaticResource IconGear}" IconSize="22"/>
            </Button>

            <Border Grid.ColumnSpan="13" Style="{StaticResource HairlineStyle}" VerticalAlignment="Top"/>
        </Grid>

        <!-- ── overlays: sheet / popover / toast / banner / drop ──────────── -->
        <Grid Grid.RowSpan="4">

            <!-- .drop -->
            <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="{ThemeResource BlueWash10Brush}">
                <Rectangle
                    Stroke="{ThemeResource BlueBrush}"
                    StrokeThickness="2.5"
                    StrokeDashArray="4,3"
                    RadiusX="16"
                    RadiusY="16"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource BlueBrush}"
                    Text="松开以添加下载"/>
            </Grid>

            <!-- .banner -->
            <Border
                x:Name="Banner"
                Width="308"
                Margin="0,12,0,0"
                Padding="13,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Background="{ThemeResource BannerBrush}"
                CornerRadius="17"
                ui:Effects.Shadow="{StaticResource BannerShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BannerOffset"/>
                </Border.RenderTransform>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource GreenBrush}">
                        <controls:StrokeIcon Data="{StaticResource IconCheck}" IconSize="17" Thickness="2.6" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource NoticeTitleTextStyle}" Text="下载完成"/>
                        <TextBlock x:Name="BannerSubtitle" Style="{StaticResource RowSubTextStyle}" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" Content="打开" Click="OnBannerOpenClick"/>
                </Grid>
            </Border>

            <!-- .toast -->
            <Border
                x:Name="Toast"
                Margin="0,0,0,64"
                Padding="16,9"
                MaxWidth="470"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="{ThemeResource ToastBrush}"
                CornerRadius="20"
                ui:Effects.Shadow="{StaticResource ToastShadow}"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ToastScale"/>
                </Border.RenderTransform>
                <TextBlock
                    x:Name="ToastText"
                    FontSize="13.5"
                    CharacterSpacing="-7"
                    Foreground="White"
                    TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- popovers and sheets are added here at runtime so they sit above everything -->
        <Grid x:Name="OverlayHost" Grid.RowSpan="4" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
