<UserControl
    x:Class="NetTrans.Views.Controls.SegmentedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <!-- `.seg`: 2px-inset white thumb sliding under N equal-width buttons. -->
    <!--
        Height is the design's own 32px rather than whatever the button text
        measures to: the CSS pins it through padding on a font this platform
        does not have, and letting Segoe decide gave 28.
    -->
    <Border
        x:Name="Track"
        Height="32"
        Background="{ThemeResource FillBrush}"
        CornerRadius="{StaticResource RadiusSeg}"
        SizeChanged="OnTrackSizeChanged">

        <Grid>
            <Border
                x:Name="Thumb"
                HorizontalAlignment="Left"
                Margin="0,2,0,2"
                Background="{ThemeResource SegThumbBrush}"
                CornerRadius="{StaticResource RadiusSegThumb}"
                ui:Effects.Shadow="{StaticResource SegThumbShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbOffset"/>
                </Border.RenderTransform>
            </Border>

            <Grid x:Name="Buttons"/>
        </Grid>
    </Border>
</UserControl>
