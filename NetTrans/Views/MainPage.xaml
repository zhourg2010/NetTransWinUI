<UserControl
    x:Class="NetTrans.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NetTrans.Views.Controls"
    xmlns:conv="using:NetTrans.Converters">

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TitleBarControl x:Name="TitleBar" Grid.Row="0"/>
        <controls:MenuBarControl x:Name="MenuBar" Grid.Row="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
        <controls:CommandBarControl x:Name="CommandBar" Grid.Row="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:NavRailControl Grid.Column="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:PageHeaderControl Grid.Row="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

                <ScrollViewer Grid.Row="1" Padding="32,0,32,24">
                    <StackPanel>

                        <!-- Active -->
                        <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(ViewModel.CurrentSection, 'active'), Mode=OneWay}">
                            <controls:PasteInfoBarControl ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
                            <Grid Padding="4,16,4,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" StrokeThickness="1.6"/>
                                    <TextBlock Text="In progress" Style="{StaticResource SectionHeadTextStyle}"/>
                                    <Border Style="{StaticResource CountBadgeStyle}">
                                        <TextBlock Style="{StaticResource CountBadgeTextStyle}" Text="{x:Bind ViewModel.FilteredActiveDownloads.Count, Mode=OneWay}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredActiveDownloads, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ActiveRowControl RowSelected="OnRowSelected"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Completed / History (same layout, different source) -->
                        <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(ViewModel.CurrentSection, 'completed'), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredCompletedDownloads, Mode=OneWay}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:CompletedRowControl/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(ViewModel.CurrentSection, 'history'), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredCompletedDownloads, Mode=OneWay}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:CompletedRowControl/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Scheduled -->
                        <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(ViewModel.CurrentSection, 'scheduled'), Mode=OneWay}"
                                    Padding="0,60" HorizontalAlignment="Center" Spacing="12">
                            <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource AccentColor}" Opacity="0.10"/>
                                </Border.Background>
                                <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconSchedule}" Width="56" Height="56" StrokeThickness="1.1" Stroke="{ThemeResource AccentBrush}"/>
                            </Border>
                            <TextBlock Style="{StaticResource EmptyTitleTextStyle}" Text="Three transfers scheduled"/>
                            <TextBlock Style="{StaticResource EmptySubTextStyle}" Text="NetTrans will start them automatically when off-peak hours begin (02:00 – 06:00)."/>
                            <Button Style="{StaticResource PrimaryAccentButtonStyle}" Content="Manage schedule" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Settings (inline page mirrors the dialog's Downloads/Browser-capture cards) -->
                        <StackPanel Visibility="{x:Bind conv:BindingHelpers.VisibleIfEqual(ViewModel.CurrentSection, 'settings'), Mode=OneWay}"
                                    Padding="0,8,0,24" MaxWidth="880">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource Stroke1Brush}" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Default save location" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="C:\Users\you\Downloads" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Style="{StaticResource StrokeIconStyle}" Data="{StaticResource IconFolder}" Width="14" Height="14" StrokeThickness="1.4"/>
                                                <TextBlock Text="Change"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Open full settings" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Network, schedule, browser capture, and more" FontSize="12" Foreground="{ThemeResource Text3Brush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryAccentSmallButtonStyle}" Content="Open settings"
                                                Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <controls:DetailPaneControl Grid.Column="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.DetailPaneVisible, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
