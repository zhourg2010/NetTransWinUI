<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- .navsearch: the search field that replaces the nav title -->
    <Style x:Key="NavSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource FillBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--
        .frow input[type=text]: a borderless field sitting inside a form row.

        Height 24，理由和隔壁 FormSelectStyle 的 25 一样：TextBox 的模板
        自己撑到 32 高，MinHeight="0" 拦不住它（模板里的 ContentPresenter
        有自己的下限）。24 + FormRow 的上下各 10 = 44，正好是设计稿里
        .frow 的高度。v0.1.13 的视频嗅探那一屏量出来是 52，整张 sheet 因此
        比设计稿高 9px —— 高的就是这一格。
    -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- .frow input.l: same, left aligned (the URL fields) -->
    <Style x:Key="FormTextBoxLeftStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!--
        .frow select. WinUI's ComboBox template already matches the shape once
        the chrome is retinted, so this restyles rather than retemplates — a
        full template would have to reimplement the popup for no visual gain.
    -->
    <!--
        Height, not MinHeight, and not a theme resource.

        WinUI floors the dropdown at 32px from inside its own template, which
        made every settings row with one 52px where the handoff's is 46 — six
        pixels a row, compounding until the sheet no longer holds what the
        design holds. Three things do not reach it: MinHeight="0" on the style,
        ComboBoxMinHeight declared in a merged dictionary, and the same key
        declared inside both theme dictionaries. All three were tried and all
        three left the row at 52.

        An explicit Height does reach it, because it is the control's own
        layout size rather than something its template negotiates. .frow select
        is font 14 + 4px padding, which is 25.
    -->
    <Style x:Key="FormSelectStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Background" Value="{ThemeResource FillBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- .insp__ctl select: the inspector runs its dropdowns a size down -->
    <Style x:Key="InspectorSelectStyle" TargetType="ComboBox" BasedOn="{StaticResource FormSelectStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>

</ResourceDictionary>
