<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NetTrans</RootNamespace>
    <!-- Drop an AppIcon.ico into Assets\ and uncomment to brand the exe/taskbar icon:
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    -->
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Required by [LibraryImport] in Interop/NativeMethods.cs: the generated
         marshalling stubs use unsafe code (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged (no MSIX) desktop app. Flip WindowsPackageType to "MSIX" and
         add a Package.appxmanifest if you'd rather ship through MSIX/Store. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      Unpackaged still needs this on. It is what runs GenerateProjectPriFile,
      and every compiled XAML page lives in the resources.pri it produces:
      without it the build succeeds, the app starts, and then every single page
      throws "XAML parsing failed" (0x802B000A) because ms-appx:/// resolves to
      nothing. Only the controls written without a .xaml survive, which is a
      very confusing way to find out.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      …and it has to come out as resources.pri. The generator names the index
      after the project (NetTrans.pri), while an unpackaged app's resource
      loader only ever looks for resources.pri beside the executable. Same
      1.4 MB of compiled XAML either way; the wrong name is indistinguishable
      from not having built it at all.
    -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- .NET 8+ uses the portable RID graph: win-x64, not win10-x64. -->
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NetTrans</AssemblyName>
    <Product>NetTrans</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- AttachedCardShadow: the only way to reproduce the handoff's blurred
         box-shadows (segmented thumb, popovers, sheet, toast, island). -->
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetTrans.Core\NetTrans.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>
