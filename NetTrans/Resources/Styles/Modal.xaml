<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        .modal — the reference's dialogs have a fully custom head/body/foot
        layout (title+subtitle+X, scrolling body, footer hint+actions) that
        doesn't map to ContentDialog's built-in Title/PrimaryButton/
        SecondaryButton chrome, so this template strips that chrome down to
        a bare card and lets each dialog's Content supply the whole layout
        (see Views/Dialogs/NewDownloadDialog.xaml and SettingsDialog.xaml).
    -->
    <Style x:Key="AppContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="Background" Value="{ThemeResource BgBaseBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentDialog">
                    <Border x:Name="Container">
                        <Grid x:Name="LayoutRoot">
                            <Border x:Name="BackgroundElement"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MaxWidth="{TemplateBinding MaxWidth}"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    MaxHeight="{TemplateBinding MaxHeight}">
                                <Border.Shadow>
                                    <ThemeShadow/>
                                </Border.Shadow>
                                <ContentPresenter x:Name="ContentPresenter"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="DialogShowingStates">
                                    <VisualState x:Name="DialogHidden"/>
                                    <VisualState x:Name="DialogShowing"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="-10"/>
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
    </Style>

    <Style x:Key="ModalSubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}"/>
    </Style>

    <Style x:Key="ModalHeadBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="22,20,18,14"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke1Brush}"/>
    </Style>

    <Style x:Key="ModalFootBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke1Brush}"/>
        <Setter Property="Background" Value="{ThemeResource BgSubtleBrush}"/>
    </Style>

    <Style x:Key="ModalPageHeadTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="70"/>
        <Setter Property="Foreground" Value="{ThemeResource Text3Brush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

</ResourceDictionary>
