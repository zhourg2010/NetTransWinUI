<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- .field__input / .field__select — WinUI's default TextBox/ComboBox
         templates bind BorderElement to the control's own Background/
         BorderBrush, so plain Setters (no template rewrite) reproduce the
         look; only the focus-state accent underline is approximated by the
         platform's own FocusVisual instead of the CSS 2px bottom border. -->
    <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource BgLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource RadiusControl}"/>
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentBrush}"/>
    </Style>

    <Style x:Key="FieldTextAreaStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{ThemeResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource BgLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource RadiusControl}"/>
        <Setter Property="Foreground" Value="{ThemeResource Text1Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{ThemeResource Text2Brush}"/>
    </Style>

    <!-- .page-header__search / search AutoSuggestBox -->
    <Style x:Key="SearchAutoSuggestBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="Background" Value="{ThemeResource BgLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource RadiusControl}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="320"/>
    </Style>

</ResourceDictionary>
