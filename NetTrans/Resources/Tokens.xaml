<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Mirrors the CSS custom properties in the design handoff's styles.css 1:1.
        Color/opacity/theme-dependent tokens live in ThemeDictionaries so they
        swap automatically with ActualTheme. AccentBrush lives outside the theme
        dictionaries because it is a single user-chosen value shared by both
        themes (same as --accent being set inline on .app in the web prototype).
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="BgMicaColor">#F3F3F3</Color>
            <SolidColorBrush x:Key="BgBaseBrush" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="BgLayerBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BgLayer2Brush" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="BgAcrylicBrush" Color="#FCFCFC" Opacity="0.78"/>
            <SolidColorBrush x:Key="BgSubtleBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="BgHoverBrush" Color="#000000" Opacity="0.037"/>
            <SolidColorBrush x:Key="BgPressBrush" Color="#000000" Opacity="0.06"/>
            <SolidColorBrush x:Key="BgSelectedBrush" Color="#000000" Opacity="0.05"/>

            <SolidColorBrush x:Key="Text1Brush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="Text2Brush" Color="#1A1A1A" Opacity="0.72"/>
            <SolidColorBrush x:Key="Text3Brush" Color="#1A1A1A" Opacity="0.50"/>
            <SolidColorBrush x:Key="Text4Brush" Color="#1A1A1A" Opacity="0.36"/>

            <SolidColorBrush x:Key="Stroke1Brush" Color="#000000" Opacity="0.0578"/>
            <SolidColorBrush x:Key="Stroke2Brush" Color="#000000" Opacity="0.0924"/>
            <SolidColorBrush x:Key="Stroke3Brush" Color="#000000" Opacity="0.16"/>
            <SolidColorBrush x:Key="StrokeCardBrush" Color="#000000" Opacity="0.06"/>

            <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#9D5D00"/>
            <SolidColorBrush x:Key="ErrBrush" Color="#C42B1C"/>

            <SolidColorBrush x:Key="ModalScrimBrush" Color="#000000" Opacity="0.32"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BgMicaColor">#202020</Color>
            <SolidColorBrush x:Key="BgBaseBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="BgLayerBrush" Color="#2B2B2B"/>
            <SolidColorBrush x:Key="BgLayer2Brush" Color="#262626"/>
            <SolidColorBrush x:Key="BgAcrylicBrush" Color="#282828" Opacity="0.78"/>
            <SolidColorBrush x:Key="BgSubtleBrush" Color="#242424"/>
            <SolidColorBrush x:Key="BgHoverBrush" Color="#FFFFFF" Opacity="0.05"/>
            <SolidColorBrush x:Key="BgPressBrush" Color="#FFFFFF" Opacity="0.07"/>
            <SolidColorBrush x:Key="BgSelectedBrush" Color="#FFFFFF" Opacity="0.08"/>

            <SolidColorBrush x:Key="Text1Brush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Text2Brush" Color="#FFFFFF" Opacity="0.78"/>
            <SolidColorBrush x:Key="Text3Brush" Color="#FFFFFF" Opacity="0.55"/>
            <SolidColorBrush x:Key="Text4Brush" Color="#FFFFFF" Opacity="0.36"/>

            <SolidColorBrush x:Key="Stroke1Brush" Color="#FFFFFF" Opacity="0.07"/>
            <SolidColorBrush x:Key="Stroke2Brush" Color="#FFFFFF" Opacity="0.10"/>
            <SolidColorBrush x:Key="Stroke3Brush" Color="#FFFFFF" Opacity="0.18"/>
            <SolidColorBrush x:Key="StrokeCardBrush" Color="#FFFFFF" Opacity="0.08"/>

            <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#FCE100"/>
            <SolidColorBrush x:Key="ErrBrush" Color="#FF99A4"/>

            <SolidColorBrush x:Key="ModalScrimBrush" Color="#000000" Opacity="0.55"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent: single value shared across themes, overwritten at runtime by
         SettingsViewModel (App.Current.Resources["AccentBrush"] = ...). -->
    <Color x:Key="AccentColor">#0067C0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColor}" Opacity="0.9"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="White"/>

    <!-- Sizes -->
    <x:Double x:Key="TitleBarHeight">32</x:Double>
    <x:Double x:Key="MenuBarHeight">28</x:Double>
    <x:Double x:Key="CommandBarHeight">44</x:Double>
    <x:Double x:Key="NavRailWidth">260</x:Double>
    <x:Double x:Key="DetailPaneWidth">360</x:Double>

    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusRow">6</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Typography -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas</FontFamily>

</ResourceDictionary>
